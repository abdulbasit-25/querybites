NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false

# SQL authentication (default local instance)
DB_SERVER=localhost
DB_DATABASE=FoodBotDB
DB_USER=foodbot_app
DB_PASSWORD=replace-me
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_TRUSTED_CONNECTION=false

# Named instance example: DB_SERVER=localhost\\SQLEXPRESS; leave DB_PORT blank.
# Windows authentication requires optional msnodesqlv8 and Microsoft ODBC Driver 18.
# With DB_TRUSTED_CONNECTION=true, the Node process uses its current Windows identity.
